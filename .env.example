# Copie para .env e preencha GEMINI_API_KEY. Nunca versione o .env.

# --- IA ---------------------------------------------------------------------
AI_PROVIDER=gemini
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# Precisa ser compatível com o modelo e igual à dimensão da coluna products.embedding.
# Se mudar modelo ou dimensão, rode: npm run index:rebuild
EMBEDDING_DIMENSIONS=768

# --- Banco ------------------------------------------------------------------
# Só bancos locais chamados makerswap_rag_demo são aceitos (proteção contra
# alterar outro banco por engano). Credenciais válidas só no container da demo.
DATABASE_URL=postgres://rag_demo:rag_demo_local@127.0.0.1:5544/makerswap_rag_demo

# --- Recuperação ------------------------------------------------------------
# Piso de similaridade de cosseno (-1 a 1) da 1ª etapa do critério de relevância.
# NÃO é probabilidade de acerto. Calibre com: npm run calibrate
RELEVANCE_MIN_SIMILARITY=0.35
# Máximo de candidatos com estoque enviados ao modelo.
RETRIEVAL_TOP_K=8
# Máximo de candidatos sem estoque enviados ao modelo.
RETRIEVAL_OUT_OF_STOCK_K=3
# Turnos (pergunta + resposta) mantidos no histórico curto da conversa.
HISTORY_MAX_TURNS=6

# Mostra produtos, scores, filtros e contexto. Também disponível com: npm run chat:debug
RAG_DEBUG=false
